  "description": "Pawang agents: workflow Pawang sebagai Agent Skills (31 skill + pawang-init) untuk agent universal, OpenCode, Pi, dan Claude Code (marketplace).",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agent-skills",
    "workflow",
    "pawang"
  ],
  "type": "module",
