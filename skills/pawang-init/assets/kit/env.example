# Salin ke .env (atau export di shell), isi nilainya, lalu restart OpenCode.
# Nilai ini dibaca OpenCode lewat {env:NAMA} di opencode.json.
# Jangan commit .env. Hanya file *.example yang boleh dibaca agent.

# --- GitHub MCP (agent: build) ---
# Fine-grained PAT dari https://github.com/settings/personal-access-tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Context7 MCP (agent: build, explorer, implementer) ---
# API key dari https://context7.com/dashboard
CONTEXT7_API_KEY=

# --- Supabase MCP (agent: build) ---
# Saat ini opencode.json TIDAK membaca env untuk Supabase:
# project_ref ditulis langsung di URL (ganti GANTI_PROJECT_REF) dan
# autentikasi lewat login OAuth bawaan OpenCode.
# Variabel di bawah hanya dicatat sebagai referensi, belum dipakai config.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
